# Copy to .env (never commit .env). All values optional for local use.
# Database: SQLite by default. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://tenderpilot:CHANGE_ME@localhost:5432/tenderpilot
STORAGE_DIR=
SECRET_KEY=            # long random string in production (auto-generated locally if empty)
TOKEN_HOURS=12
MAX_UPLOAD_MB=200
MAX_PDF_PAGES=5000
# AI: set up in the app under Settings & audit > AI provider. A key entered there is stored encrypted
# (Windows DPAPI) and is never shown again. These values only seed the first-time defaults.
AI_PROVIDER=offline
ANTHROPIC_MODEL=claude-opus-5-5
# Server-operator fallback only; prefer Settings. Never commit a real key.
ANTHROPIC_API_KEY=
# OCR: path to tesseract.exe if not on PATH (e.g. C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=
# Language data folder. Defaults to backend\data\tessdata when that folder exists.
TESSDATA_DIR=
# Keep English first: "hin+eng" drops digits from amounts such as "Rs. 1,00,000".
OCR_LANGUAGES=eng+hin
# Legacy .doc/.xls conversion: path to soffice.exe if not found automatically
SOFFICE_CMD=
CONVERT_TIMEOUT_S=180
RUN_WORKER=1
# 1 = re-read old tenders automatically when the tender reader is upgraded. Default 0: an update never changes
# existing readings; use "Re-read with the latest reader" on a tender's Documents tab instead.
AUTO_REREAD=0
CORS_ORIGINS=http://localhost:5173
