# Copy to .env (never commit .env). All values optional for local use.
# Database: SQLite by default. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://tenderpilot:CHANGE_ME@localhost:5432/tenderpilot
STORAGE_DIR=
SECRET_KEY=            # long random string in production (auto-generated locally if empty)
TOKEN_HOURS=12
MAX_UPLOAD_MB=200
MAX_PDF_PAGES=5000
# AI: "offline" (default, nothing leaves the server) or "anthropic" (also needs the org admin's consent in Settings)
AI_PROVIDER=offline
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_MAX_TOKENS=4000
# OCR: path to tesseract.exe if not on PATH (e.g. C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=
OCR_LANGUAGES=eng+hin
RUN_WORKER=1
CORS_ORIGINS=http://localhost:5173
